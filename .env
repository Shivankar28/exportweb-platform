SECRET_KEY=exportweb_super_secret_key_change_in_production_2026
FLASK_ENV=development
DEBUG=True

# MySQL connection string
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/exportweb_db
USE_SQLITE_FALLBACK=True

# Cloudinary Configuration (Optional - falls back to local uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Mail Configuration (Optional - falls back to console logging if empty)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@exportweb.com
