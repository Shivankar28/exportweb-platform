# Flask Settings
SECRET_KEY=exportweb_super_secret_key_change_in_production_2026
FLASK_ENV=development
DEBUG=True

# Database Configuration (MySQL as primary, SQLite fallback if MySQL is not available)
# Standard MySQL format: mysql+pymysql://username:password@localhost:3306/db_name
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/exportweb_db
USE_SQLITE_FALLBACK=True

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=noreply@exportweb.com
